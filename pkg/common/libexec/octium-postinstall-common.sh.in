#!/bin/sh
set -eu

# Common post-install helpers intended to be called from package maintainer
# scripts (deb postinst, rpm %post, etc.).

log() {
	# Prefer stderr so the message shows up in package-manager logs.
	echo "@CLI_TOOL_NAME@: $*" >&2
}

is_noninteractive() {
	# A best-effort check.
	# - DEBIAN_FRONTEND=noninteractive is common for apt/dpkg.
	# - no TTY usually means CI/noninteractive installs.
	if [ "${DEBIAN_FRONTEND:-}" = "noninteractive" ]; then
		return 0
	fi
	if [ ! -t 0 ] || [ ! -t 1 ]; then
		return 0
	fi
	return 1
}

invoking_user() {
	# Maintainer scripts run as root. Try to infer the human invoker.
	# 1) sudo installs: $SUDO_USER
	# 2) otherwise: logname (may fail in some CI contexts)
	if [ -n "${SUDO_USER:-}" ] && [ "${SUDO_USER}" != "root" ]; then
		echo "${SUDO_USER}"
		return 0
	fi

	# logname exits non-zero if no login name is associated with the session.
	if command -v logname >/dev/null 2>&1; then
		u="$(logname 2>/dev/null || true)"
		if [ -n "${u}" ] && [ "${u}" != "root" ]; then
			echo "${u}"
			return 0
		fi
	fi

	return 1
}

ensure_sudoers_dropin_perms() {
	dropin="$1"

	# If sudo isn't installed, the dir may still exist (created by packaging), but
	# ensure it's at least present.
	if [ ! -d /etc/sudoers.d ]; then
		mkdir -p /etc/sudoers.d
	fi

	# sudo on Debian typically wants 0750; 0755 is also commonly accepted.
	chmod 0750 /etc/sudoers.d 2>/dev/null || chmod 0755 /etc/sudoers.d || true
	chown root:root /etc/sudoers.d 2>/dev/null || true

	if [ -f "${dropin}" ]; then
		chown root:root "${dropin}" 2>/dev/null || true
		chmod 0440 "${dropin}" 2>/dev/null || true
	fi
}

ensure_root_executable() {
	path="$1"
	if [ -f "${path}" ]; then
		chown root:root "${path}" 2>/dev/null || true
		chmod 0755 "${path}" 2>/dev/null || true
	fi
}

provision_invoking_user() {
	user=""
	if user="$(invoking_user)"; then
		:
	else
		log "unable to determine invoking user; skipping auto-provision."
		log "provision later: sudo /usr/libexec/@CLI_TOOL_NAME@/octium-provision-user <username>"
		return 0
	fi

	sandbox_user="@CLI_TOOL_NAME@-${user}"
	if id "${sandbox_user}" >/dev/null 2>&1; then
		# The most important signal that provisioning already happened is the
		# existence of the per-end-user sandbox account.
		#
		# Note: wrapper and sudoers drop-in regeneration (for upgrades) is handled
		# separately by upgrade_provisioned_users().
		log "sandbox user '${sandbox_user}' already exists; skipping provisioning prompt."
		log "to reprovision/update: sudo /usr/libexec/@CLI_TOOL_NAME@/octium-provision-user ${user}"
		return 0
	fi

	# Some packaging flows may install libexec scripts without the executable bit.
	# Ensure the provisioning script is root-owned and executable before we try to
	# run it from a maintainer script.
	ensure_root_executable "/usr/libexec/@CLI_TOOL_NAME@/@CLI_TOOL_NAME@-provision-user"

	if ! id "${user}" >/dev/null 2>&1; then
		log "invoking user '${user}' does not exist; skipping auto-provision."
		return 0
	fi

	if is_noninteractive; then
		log "non-interactive install detected; auto-provisioning for '${user}'."
	else
		echo "Provision @CLI_TOOL_NAME@ sandbox account for '${user}' now?" >&2
		printf "(This creates user '@CLI_TOOL_NAME@-${user}' and group '@CLI_TOOL_NAME@-${user}-shared'.) [Y/n]: " >&2
		read -r ans || ans=""
		case "${ans}" in
			n|N|no|NO)
				log "not provisioning for '${user}' (user declined)."
				log "provision later: sudo /usr/libexec/@CLI_TOOL_NAME@/octium-provision-user ${user}"
				return 0
				;;
		esac
	fi

	if [ ! -x /usr/libexec/@CLI_TOOL_NAME@/@CLI_TOOL_NAME@-provision-user ]; then
		log "missing provisioning script; cannot auto-provision."
		return 0
	fi

	/usr/libexec/@CLI_TOOL_NAME@/@CLI_TOOL_NAME@-provision-user "${user}" || true
}

list_existing_sandbox_users() {
	# Output one sandbox username per line.
	# Best-effort: prefer getent, fall back to /etc/passwd.
	if command -v getent >/dev/null 2>&1; then
		getent passwd 2>/dev/null | cut -d: -f1
		return 0
	fi
	if [ -r /etc/passwd ]; then
		cut -d: -f1 /etc/passwd
		return 0
	fi
	return 1
}

upgrade_provisioned_users() {
	# During upgrades, there may be N previously provisioned end users.
	# Re-run the provisioning logic for each existing sandbox user so that any
	# install-time artifacts are updated holistically:
	# - wrapper hardening changes (run-as-<sandbox>)
	# - sudoers drop-ins
	# - sandbox $HOME directory layout/permissions
	# - packaged dotfiles (e.g. .gitconfig, managed .bash_profile block)
	#
	# This intentionally reuses the provisioning script itself instead of
	# duplicating its logic here.

	prov="/usr/libexec/@CLI_TOOL_NAME@/@CLI_TOOL_NAME@-provision-user"
	if [ ! -f "${prov}" ]; then
		return 0
	fi
	ensure_root_executable "${prov}"
	if [ ! -x "${prov}" ]; then
		return 0
	fi

	users="$(list_existing_sandbox_users 2>/dev/null || true)"
	if [ -z "${users}" ]; then
		return 0
	fi

	echo "${users}" | while IFS= read -r sandbox_user; do
		case "${sandbox_user}" in
			@CLI_TOOL_NAME@-*) ;;
			*) continue ;;
		esac

		# The provisioning script takes the end-user name.
		end_user="${sandbox_user#@CLI_TOOL_NAME@-}"
		if [ -z "${end_user}" ]; then
			continue
		fi

		# If the end user no longer exists, we can't safely reprovision/update.
		if ! id "${end_user}" >/dev/null 2>&1; then
			log "end user '${end_user}' not found; skipping upgrade for '${sandbox_user}'."
			continue
		fi

		# Best-effort: upgrade in-place. The provisioner is idempotent and will
		# update existing artifacts.
		@CLI_TOOL_NAME@_UPGRADE=1 "${prov}" "${end_user}" || true
	done
}
