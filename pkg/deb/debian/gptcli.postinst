#!/bin/sh
set -e

case "$1" in
	configure)
		# Ensure packaged /etc/sudoers.d drop-ins have correct perms.
		if [ -x /usr/libexec/gptcli/gptcli-postinstall-common.sh ]; then
			. /usr/libexec/gptcli/gptcli-postinstall-common.sh
			ensure_sudoers_dropin_perms "/etc/sudoers.d/gptcli-share-aiagent-echo" || true
			ensure_root_executable "/usr/libexec/gptcli/run-as-aiagent" || true
		fi

		# Ensure sysusers/tmpfiles artifacts are applied at install/upgrade time.
		if command -v systemd-sysusers >/dev/null 2>&1; then
			systemd-sysusers /usr/lib/sysusers.d/gptcli-aiagent.conf || true
		fi
		if command -v systemd-tmpfiles >/dev/null 2>&1; then
			systemd-tmpfiles --create /usr/lib/tmpfiles.d/gptcli-aiagent.conf || true
		fi

		# Enroll the invoking user into gptcli-share (best-effort).
		if [ -x /usr/libexec/gptcli/gptcli-postinstall-common.sh ]; then
			. /usr/libexec/gptcli/gptcli-postinstall-common.sh
			maybe_add_invoker_to_group "gptcli-share" || true
		fi
		;;
esac

#DEBHELPER#
exit 0
