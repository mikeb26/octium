#!/bin/sh
set -eu

# Root-run wrapper intended to be invoked via sudoers by members of the
# @CLI_SANDBOX_GROUPNAME@ group.
#
# It runs an arbitrary command as the dedicated sandbox user "@CLI_SANDBOX_USERNAME@" inside a
# hardened transient systemd unit.
#
# Environment behavior:
# - Start from an empty environment (env -i).
# - Seed PATH with a filtered version of the invoker's PATH (best-effort).
# - Invoke bash as a *login* shell so it can apply @CLI_SANDBOX_USERNAME@'s profile scripts
#   (e.g. ~/.bash_profile or ~/.profile), which may further modify PATH and other
#   env for the final exec.

PATH="/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export PATH

DEFAULT_PROXY_ADDR="127.0.0.1:8080"

log() {
	echo "@CLI_TOOL_NAME@: $*" >&2
}

require_root() {
	if [ "$(id -u)" -ne 0 ]; then
		log "must be run as root (expected via sudo)."
		exit 1
	fi
}

require_args() {
	if [ "$#" -lt 1 ]; then
		log "usage: $(basename "$0") [--proxy-addr <host:port>] [--cwd <dir>] <command> [args...]"
		exit 2
	fi
}

validate_proxy_port() {
	proxy_port="$1"
	# Validate proxy port (fixed/explicit only; do not allow 0).
	case "$proxy_port" in
		''|*[!0-9]*)
			log "invalid proxy-port: $proxy_port"
			exit 2
			;;
	esac
	if [ "$proxy_port" -lt 1 ] || [ "$proxy_port" -gt 65535 ]; then
		log "invalid proxy-port: $proxy_port"
		exit 2
	fi
}

validate_proxy_addr() {
	proxy_addr="$1"
	if [ -z "${proxy_addr:-}" ]; then
		log "invalid --proxy-addr: empty"
		exit 2
	fi

	# Expect host:port (matching internal/httpproxy/proxy.go:ProxyAddr()).
	# We intentionally restrict the host to loopback for safety.
	case "$proxy_addr" in
		*:*:*)
			log "invalid --proxy-addr (IPv6 or multiple colons not supported): $proxy_addr"
			exit 2
			;;
		*:*)
			;;
		*)
			log "invalid --proxy-addr (expected host:port): $proxy_addr"
			exit 2
			;;
	esac

	host="${proxy_addr%:*}"
	port="${proxy_addr##*:}"
	case "$host" in
		127.0.0.1|localhost)
			;;
		*)
			log "invalid --proxy-addr host (must be 127.0.0.1 or localhost): $host"
			exit 2
			;;
	esac
	validate_proxy_port "$port"
}

have_systemd_run() {
	command -v systemd-run >/dev/null 2>&1
}

sandbox_home_dir() {
	# Determine @CLI_SANDBOX_USERNAME@'s home directory.
	# Prefer getent when available; fall back to /home/@CLI_SANDBOX_USERNAME@.
	if command -v getent >/dev/null 2>&1; then
		home="$(getent passwd @CLI_SANDBOX_USERNAME@ | cut -d: -f6 || true)"
		if [ -n "${home:-}" ]; then
			echo "$home"
			return
		fi
	fi
	echo "/home/@CLI_SANDBOX_USERNAME@"
}

ensure_sandbox_home() {
	sbhome="$1"

	# systemd-run will fail with a systemd-specific exit status (e.g. 200/CHDIR)
	# if WorkingDirectory doesn't exist. Be robust in case sysusers/tmpfiles
	# haven't been applied yet.
	if ! id @CLI_SANDBOX_USERNAME@ >/dev/null 2>&1; then
		log "user '@CLI_SANDBOX_USERNAME@' does not exist."
		log "ensure sysusers was applied (e.g. systemd-sysusers /usr/lib/sysusers.d/@CLI_TOOL_NAME@-@CLI_SANDBOX_USERNAME@.conf)."
		exit 1
	fi

	if [ ! -d "$sbhome" ]; then
		mkdir -p "$sbhome"
		chown @CLI_SANDBOX_USERNAME@:@CLI_SANDBOX_USERNAME@ "$sbhome" || true
		chmod 0750 "$sbhome" || true
	fi
}

validate_cwd() {
	sbhome="$1"
	cwd="$2"

	if [ -z "${cwd:-}" ]; then
		log "invalid --cwd: empty"
		exit 2
	fi

	# Only allow absolute paths.
	case "$cwd" in
		/*) ;;
		*)
			log "invalid --cwd (must be absolute): $cwd"
			exit 2
			;;
	esac

	# Only allow directories under the sandbox home.
	case "$cwd" in
		"$sbhome"|"$sbhome"/*) ;;
		*)
			log "invalid --cwd (must be under sandbox home $sbhome): $cwd"
			exit 2
			;;
	esac

	# Require that the directory exists.
	if [ ! -d "$cwd" ]; then
		log "invalid --cwd (directory does not exist): $cwd"
		exit 2
	fi
}

invoker_path() {
	# Best-effort attempt to recover the PATH from the first non-root ancestor
	# process (typically the user's shell) instead of relying on sudo's sanitized
	# environment.
	#
	# If anything looks off, return empty and let the caller choose a safe default.
	pid="$$"
	while [ -r "/proc/$pid/status" ]; do
		uid="$(awk '/^Uid:/ {print $2; exit}' "/proc/$pid/status" 2>/dev/null || true)"
		ppid="$(awk '/^PPid:/ {print $2; exit}' "/proc/$pid/status" 2>/dev/null || true)"
		if [ -n "${uid:-}" ] && [ "$uid" -ne 0 ]; then
			if [ -r "/proc/$pid/environ" ]; then
				# NUL-separated env; extract PATH.
				path_val="$(tr '\000' '\n' < "/proc/$pid/environ" | sed -n 's/^PATH=//p' | head -n 1 || true)"
				if [ -n "${path_val:-}" ]; then
					echo "$path_val"
					return
				fi
			fi
			return
		fi
		if [ -z "${ppid:-}" ] || [ "$ppid" -le 1 ]; then
			return
		fi
		pid="$ppid"
	done
}

filter_path() {
	# Filter a PATH-like string down to a conservative allowlist of directories.
	#
	# Rules:
	# - Only absolute paths.
	# - Only strict subdirs of: /usr, /opt, /bin, /sbin.
	# - Must exist as a directory.
	# - Must not be writable by group/other (prevents trivial path hijacking).
	#
	# If the result is empty, the caller should fall back to a safe default.
	in_path="$1"
	out_path=""
	old_ifs="$IFS"
	IFS=:
	for d in $in_path; do
		case "$d" in
			/*) ;;
			*) continue ;;
		esac
		case "$d" in
			/usr/*|/opt/*|/bin|/bin/*|/sbin|/sbin/*) ;;
			*) continue ;;
		esac
		[ -d "$d" ] || continue

		# Permissions check (Linux/GNU stat assumed on target distros)
		# Require: not group-writable and not other-writable.
		mode="$(stat -c %a "$d" 2>/dev/null || true)"
		[ -n "${mode:-}" ] || continue
		g_digit="$(echo "$mode" | awk '{print substr($0,length($0)-1,1)}')"
		o_digit="$(echo "$mode" | awk '{print substr($0,length($0),1)}')"
		case "$g_digit" in
			0|1|2|3|4|5) ;;
			*) continue ;;
		esac
		case "$o_digit" in
			0|1|2|3|4|5) ;;
			*) continue ;;
		esac

		if [ -z "$out_path" ]; then
			out_path="$d"
		else
			out_path="$out_path:$d"
		fi
	done
	IFS="$old_ifs"

	echo "$out_path"
}

require_systemd_run() {
	if have_systemd_run; then
		return
	fi
	log "systemd-run is required but was not found in PATH."
	log "Install systemd (and systemd-run) or adjust your packaging/configuration."
	exit 1
}

half_system_memory_kb() {
	# Return half of total system memory in KiB (rounded down).
	# Used for MemoryMax.
	#
	# If we fail to detect total memory, return empty and let the caller decide.
	mem_total_kb="$(awk '/^MemTotal:/ {print $2; exit}' /proc/meminfo 2>/dev/null || true)"
	case "$mem_total_kb" in
		''|*[!0-9]*)
			return
			;;
	esac
	echo $((mem_total_kb / 2))
}

run_via_systemd() {
	# Use the system manager so we can apply hardening without needing extra
	# polkit configuration.

	sbhome="$(sandbox_home_dir)"
	ensure_sandbox_home "$sbhome"

	# Default to sandbox home unless the caller provided a validated cwd.
	wd="$sbhome"
	if [ -n "${CWD:-}" ]; then
		validate_cwd "$sbhome" "$CWD"
		wd="$CWD"
	fi
	upath="$(invoker_path || true)"
	fpath=""
	if [ -n "${upath:-}" ]; then
		fpath="$(filter_path "$upath" || true)"
	fi
	if [ -z "${fpath:-}" ]; then
		fpath="/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
	fi

	# Execute the user command via a bash *login* shell so that profile scripts can
	# adjust PATH and other env before the final exec.
	#
	# NOTE: bash does not automatically read ~/.bashrc for non-interactive shells.
	# If you need ~/.bashrc behavior here, ensure @CLI_SANDBOX_USERNAME@'s ~/.bash_profile
	# sources it.
        #
	# Use a tmpfs for /home (hides other users' homes) and then bind-mount
	# @CLI_SANDBOX_USERNAME@'s real home back in.
	#
	# NOTE: ProtectHome=yes makes /home inaccessible and causes CHDIR failures
	# on some systems even when ReadWritePaths is set.
	#
	# Networking model:
	# - Allow loopback TCP/IPv4+IPv6 (for httpproxy on 127.0.0.1/::1).
	# - Deny all other IP ranges (best-effort, systemd feature-dependent).
	#
	# IMPORTANT: This is NOT a cryptographic/airtight guarantee that the process
	# can only reach the proxy port. systemd can restrict destination IP ranges,
	# but typically cannot enforce destination ports. A process may still be able
	# to speak directly to 127.0.0.1 on other ports.
	#
	# Additionally, restricting protocol families blocks raw sockets/packet
	# sockets (ICMP etc), but cannot prevent a process from using TCP to any
	# allowed destination IP/port.
	memmax_kb="$(half_system_memory_kb || true)"
	memmax_prop=""
	if [ -n "${memmax_kb:-}" ]; then
		memmax_prop="--property=MemoryMax=${memmax_kb}K"
	fi

	systemd-run \
		--wait \
		--collect \
		--pipe \
		--uid=@CLI_SANDBOX_USERNAME@ \
                --property=SupplementaryGroups=octium-users \
		$memmax_prop \
		--property=TasksMax=1024 \
		--property=RuntimeMaxSec=600 \
		--property=Nice=19 \
		--property=CPUSchedulingPolicy=batch \
		--property=IOSchedulingClass=idle \
		--property=NoNewPrivileges=yes \
		--property=PrivateTmp=yes \
		--property=PrivateDevices=yes \
		--property=PrivateNetwork=no \
		--property=CapabilityBoundingSet= \
		--property=AmbientCapabilities= \
		--property=LockPersonality=yes \
		--property=RestrictNamespaces=yes \
		--property=RestrictRealtime=yes \
		--property=RestrictSUIDSGID=yes \
		--property=RestrictAddressFamilies="AF_INET AF_INET6" \
		--property=IPAddressAllow=127.0.0.1/32 \
		--property=IPAddressAllow=::1/128 \
		--property=IPAddressDeny=any \
		--property=ProtectSystem=strict \
		--property=ProtectHome=tmpfs \
		--property=BindPaths="$sbhome:$sbhome" \
		--property=ReadWritePaths="$sbhome" \
		--property=ProtectKernelTunables=yes \
		--property=ProtectKernelModules=yes \
		--property=ProtectControlGroups=yes \
		--property=UMask=0077 \
		--property=WorkingDirectory="$wd" \
			-- /usr/bin/env -i HOME="$sbhome" PATH="$fpath" USER=@CLI_SANDBOX_USERNAME@ LOGNAME=@CLI_SANDBOX_USERNAME@ \
				http_proxy="http://$PROXY_ADDR" \
				https_proxy="http://$PROXY_ADDR" \
				HTTP_PROXY="http://$PROXY_ADDR" \
				HTTPS_PROXY="http://$PROXY_ADDR" \
				no_proxy="localhost,127.0.0.1,::1" \
				NO_PROXY="localhost,127.0.0.1,::1" \
				/bin/bash --login -c 'exec "$@"' -- "$@"
}

main() {
	require_root
	require_systemd_run

	PROXY_ADDR="$DEFAULT_PROXY_ADDR"
	CWD=""
	while [ "$#" -gt 0 ]; do
		case "$1" in
			--proxy-addr)
				shift
				if [ "$#" -lt 1 ]; then
					log "--proxy-addr requires a value"
					exit 2
				fi
				validate_proxy_addr "$1"
				PROXY_ADDR="$1"
				shift
				;;
			--proxy-addr=*)
				p="${1#--proxy-addr=}"
				validate_proxy_addr "$p"
				PROXY_ADDR="$p"
				shift
				;;
			--cwd)
				shift
				if [ "$#" -lt 1 ]; then
					log "--cwd requires a value"
					exit 2
				fi
				CWD="$1"
				shift
				;;
			--cwd=*)
				CWD="${1#--cwd=}"
				shift
				;;
			--)
				shift
				break
				;;
			-*)
				log "unknown flag: $1"
				exit 2
				;;
			*)
				break
				;;
		esac
	done

	require_args "$@"

	run_via_systemd "$@"
}

main "$@"
