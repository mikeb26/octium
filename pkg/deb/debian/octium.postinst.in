#!/bin/sh
set -e

case "$1" in
	configure)
		# Ensure packaged /etc/sudoers.d drop-ins have correct perms.
		if [ -x /usr/libexec/@CLI_TOOL_NAME@/@CLI_TOOL_NAME@-postinstall-common.sh ]; then
			. /usr/libexec/@CLI_TOOL_NAME@/@CLI_TOOL_NAME@-postinstall-common.sh
			# No-op in the new per-user design; drop-ins are provisioned per user.
			:
		fi

		# Provision a dedicated sandbox user+groups for the invoking end user.
		if [ -x /usr/libexec/@CLI_TOOL_NAME@/@CLI_TOOL_NAME@-postinstall-common.sh ]; then
			. /usr/libexec/@CLI_TOOL_NAME@/@CLI_TOOL_NAME@-postinstall-common.sh
			provision_invoking_user || true
		fi
		;;
esac

#DEBHELPER#
exit 0
