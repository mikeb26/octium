# The ncurses TUI binary is built as n@CLI_TOOL_NAME@ (e.g. noctium).
n@CLI_TOOL_NAME@ usr/bin/

pkg/common/libexec/@CLI_TOOL_NAME@-postinstall-common.sh usr/libexec/@CLI_TOOL_NAME@/
pkg/common/libexec/@CLI_TOOL_NAME@-provision-user usr/libexec/@CLI_TOOL_NAME@/
pkg/common/libexec/run-as.template usr/libexec/@CLI_TOOL_NAME@/
pkg/common/share/gitconfig usr/share/@CLI_TOOL_NAME@/
pkg/common/share/bashprofile usr/share/@CLI_TOOL_NAME@/
