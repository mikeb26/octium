#!/bin/sh
set -e

case "$1" in
	configure)
		# Ensure packaged /etc/sudoers.d drop-ins have correct perms.
		if [ -x /usr/libexec/@CLI_TOOL_NAME@/@CLI_TOOL_NAME@-postinstall-common.sh ]; then
			. /usr/libexec/@CLI_TOOL_NAME@/@CLI_TOOL_NAME@-postinstall-common.sh
			ensure_sudoers_dropin_perms "/etc/sudoers.d/@CLI_SANDBOX_GROUPNAME@-@CLI_SANDBOX_USERNAME@-echo" || true
			ensure_root_executable "/usr/libexec/@CLI_TOOL_NAME@/run-as-@CLI_SANDBOX_USERNAME@" || true
		fi

		# Ensure sysusers/tmpfiles artifacts are applied at install/upgrade time.
		if command -v systemd-sysusers >/dev/null 2>&1; then
			systemd-sysusers /usr/lib/sysusers.d/@CLI_TOOL_NAME@-@CLI_SANDBOX_USERNAME@.conf || true
		fi
		if command -v systemd-tmpfiles >/dev/null 2>&1; then
			systemd-tmpfiles --create /usr/lib/tmpfiles.d/@CLI_TOOL_NAME@-@CLI_SANDBOX_USERNAME@.conf || true
		fi

		# Enroll the invoking user into @CLI_SANDBOX_GROUPNAME@ (best-effort).
		if [ -x /usr/libexec/@CLI_TOOL_NAME@/@CLI_TOOL_NAME@-postinstall-common.sh ]; then
			. /usr/libexec/@CLI_TOOL_NAME@/@CLI_TOOL_NAME@-postinstall-common.sh
			maybe_add_invoker_to_group "@CLI_SANDBOX_GROUPNAME@" || true
		fi
		;;
esac

#DEBHELPER#
exit 0
