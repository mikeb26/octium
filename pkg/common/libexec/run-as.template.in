#!/bin/sh
set -eu

# Root-run wrapper intended to be invoked via sudoers by members of the
# per-user shared group.
#
# This file is used as a provisioning-time template. The provisioning script
# substitutes @RUNTIME_SANDBOX_USERNAME@ and @RUNTIME_SANDBOX_GROUPNAME@ to create a
# per-end-user wrapper: run-as-<sandboxuser>.
#
# It runs an arbitrary command as the dedicated sandbox user "@RUNTIME_SANDBOX_USERNAME@" inside a
# hardened transient systemd unit.
#
# Environment behavior:
# - Start from an empty environment (env -i).
# - Seed PATH with a filtered version of the invoker's PATH (best-effort).
# - Invoke bash as a *login* shell so it can apply SANDBOX_USER's profile scripts
#   (e.g. ~/.bash_profile or ~/.profile), which may further modify PATH and other
#   env for the final exec.

PATH="/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export PATH

DEFAULT_PROXY_ADDR="127.0.0.1:8080"

log() {
	echo "@CLI_TOOL_NAME@: $*" >&2
}

# Provisioner replaces these placeholders at provision time.
SANDBOX_USER="@RUNTIME_SANDBOX_USERNAME@"
SANDBOX_GROUP="@RUNTIME_SANDBOX_GROUPNAME@"

require_root() {
	if [ "$(id -u)" -ne 0 ]; then
		log "must be run as root (expected via sudo)."
		exit 1
	fi
}

require_args() {
	if [ "$#" -lt 1 ]; then
		log "usage: $(basename "$0") [--proxy-addr <host:port> | --full-network] [--cwd <dir>] <command> [args...]"
		exit 2
	fi
}

validate_proxy_port() {
	proxy_port="$1"
	# Validate proxy port (fixed/explicit only; do not allow 0).
	case "$proxy_port" in
		''|*[!0-9]*)
			log "invalid proxy-port: $proxy_port"
			exit 2
			;;
	esac
	if [ "$proxy_port" -lt 1 ] || [ "$proxy_port" -gt 65535 ]; then
		log "invalid proxy-port: $proxy_port"
		exit 2
	fi
}

validate_proxy_addr() {
	proxy_addr="$1"
	if [ -z "${proxy_addr:-}" ]; then
		log "invalid --proxy-addr: empty"
		exit 2
	fi

	# Expect host:port (matching internal/httpproxy/proxy.go:ProxyAddr()).
	# We intentionally restrict the host to loopback for safety.
	case "$proxy_addr" in
		*:*:*)
			log "invalid --proxy-addr (IPv6 or multiple colons not supported): $proxy_addr"
			exit 2
			;;
		*:*)
			;;
		*)
			log "invalid --proxy-addr (expected host:port): $proxy_addr"
			exit 2
			;;
	esac

	host="${proxy_addr%:*}"
	port="${proxy_addr##*:}"
	case "$host" in
		127.0.0.1|localhost)
			;;
		*)
			log "invalid --proxy-addr host (must be 127.0.0.1 or localhost): $host"
			exit 2
			;;
	esac
	validate_proxy_port "$port"
}

have_systemd_run() {
	command -v systemd-run >/dev/null 2>&1
}

sandbox_home_dir() {
	# Determine SANDBOX_USER's home directory.
	# Prefer getent when available; fall back to /home/<SANDBOX_USER>.
	if command -v getent >/dev/null 2>&1; then
		home="$(getent passwd "$SANDBOX_USER" | cut -d: -f6 || true)"
		if [ -n "${home:-}" ]; then
			echo "$home"
			return
		fi
	fi
	echo "/home/$SANDBOX_USER"
}

ensure_sandbox_home() {
	sbhome="$1"

	# systemd-run will fail with a systemd-specific exit status (e.g. 200/CHDIR)
	# if WorkingDirectory doesn't exist.
	if ! id "$SANDBOX_USER" >/dev/null 2>&1; then
		log "user '$SANDBOX_USER' does not exist."
		exit 1
	fi

	if [ ! -d "$sbhome" ]; then
		mkdir -p "$sbhome"
		chown "$SANDBOX_USER:$SANDBOX_USER" "$sbhome" || true
		chmod 0750 "$sbhome" || true
	fi
}

validate_cwd() {
	sbhome="$1"
	cwd="$2"

	if [ -z "${cwd:-}" ]; then
		log "invalid --cwd: empty"
		exit 2
	fi

	# Only allow absolute paths.
	case "$cwd" in
		/*) ;;
		*)
			log "invalid --cwd (must be absolute): $cwd"
			exit 2
			;;
	esac

	# Only allow directories under the sandbox home.
	case "$cwd" in
		"$sbhome"|"$sbhome"/*) ;;
		*)
			log "invalid --cwd (must be under sandbox home $sbhome): $cwd"
			exit 2
			;;
	esac

	# Require that the directory exists.
	if [ ! -d "$cwd" ]; then
		log "invalid --cwd (directory does not exist): $cwd"
		exit 2
	fi
}

invoker_path() {
	pid="$$"
	while [ -r "/proc/$pid/status" ]; do
		uid="$(awk '/^Uid:/ {print $2; exit}' "/proc/$pid/status" 2>/dev/null || true)"
		ppid="$(awk '/^PPid:/ {print $2; exit}' "/proc/$pid/status" 2>/dev/null || true)"
		if [ -n "${uid:-}" ] && [ "$uid" -ne 0 ]; then
			if [ -r "/proc/$pid/environ" ]; then
				path_val="$(tr '\000' '\n' < "/proc/$pid/environ" | sed -n 's/^PATH=//p' | head -n 1 || true)"
				if [ -n "${path_val:-}" ]; then
					echo "$path_val"
					return
				fi
			fi
			return
		fi
		if [ -z "${ppid:-}" ] || [ "$ppid" -le 1 ]; then
			return
		fi
		pid="$ppid"
	done
}

filter_path() {
	in_path="$1"
	out_path=""
	old_ifs="$IFS"
	IFS=:
	for d in $in_path; do
		case "$d" in
			/*) ;;
			*) continue ;;
		esac
		case "$d" in
			/usr/*|/opt/*|/bin|/bin/*|/sbin|/sbin/*) ;;
			*) continue ;;
		esac
		[ -d "$d" ] || continue

		mode="$(stat -c %a "$d" 2>/dev/null || true)"
		[ -n "${mode:-}" ] || continue
		g_digit="$(echo "$mode" | awk '{print substr($0,length($0)-1,1)}')"
		o_digit="$(echo "$mode" | awk '{print substr($0,length($0),1)}')"
		case "$g_digit" in
			0|1|2|3|4|5) ;;
			*) continue ;;
		esac
		case "$o_digit" in
			0|1|2|3|4|5) ;;
			*) continue ;;
		esac

		if [ -z "$out_path" ]; then
			out_path="$d"
		else
			out_path="$out_path:$d"
		fi
	done
	IFS="$old_ifs"

	echo "$out_path"
}

require_systemd_run() {
	if have_systemd_run; then
		return
	fi
	log "systemd-run is required but was not found in PATH."
	exit 1
}

half_system_memory_kb() {
	mem_total_kb="$(awk '/^MemTotal:/ {print $2; exit}' /proc/meminfo 2>/dev/null || true)"
	case "$mem_total_kb" in
		''|*[!0-9]*)
			return
			;;
	esac
	echo $((mem_total_kb / 2))
}

run_via_systemd() {
	sbhome="$(sandbox_home_dir)"
	ensure_sandbox_home "$sbhome"

	wd="$sbhome"
	if [ -n "${CWD:-}" ]; then
		validate_cwd "$sbhome" "$CWD"
		wd="$CWD"
	fi
	upath="$(invoker_path || true)"
	fpath=""
	if [ -n "${upath:-}" ]; then
		fpath="$(filter_path "$upath" || true)"
	fi
	if [ -z "${fpath:-}" ]; then
		fpath="/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
	fi

	memmax_kb="$(half_system_memory_kb || true)"
	memmax_prop=""
	if [ -n "${memmax_kb:-}" ]; then
		memmax_prop="--property=MemoryMax=${memmax_kb}K"
	fi

	net_props=""
	env_proxy_vars=""
	if [ "${FULL_NETWORK:-0}" -eq 0 ]; then
		net_props="--property=IPAddressAllow=127.0.0.1/32 --property=IPAddressAllow=::1/128 --property=IPAddressDeny=any"
		env_proxy_vars="http_proxy=http://$PROXY_ADDR https_proxy=http://$PROXY_ADDR HTTP_PROXY=http://$PROXY_ADDR HTTPS_PROXY=http://$PROXY_ADDR no_proxy=localhost,127.0.0.1,::1 NO_PROXY=localhost,127.0.0.1,::1"
	fi

	systemd-run \
		--wait \
		--collect \
		--pipe \
		--uid="$SANDBOX_USER" \
		--property=SupplementaryGroups="$SANDBOX_GROUP" \
		$memmax_prop \
		--property=TasksMax=1024 \
		--property=RuntimeMaxSec=600 \
		--property=Nice=19 \
		--property=CPUSchedulingPolicy=batch \
		--property=IOSchedulingClass=idle \
		--property=NoNewPrivileges=yes \
		--property=PrivateTmp=yes \
		--property=PrivateDevices=yes \
		--property=PrivateNetwork=no \
		--property=CapabilityBoundingSet= \
		--property=AmbientCapabilities= \
		--property=LockPersonality=yes \
		--property=RestrictNamespaces=yes \
		--property=RestrictRealtime=yes \
		--property=RestrictAddressFamilies="AF_INET AF_INET6" \
		$net_props \
		--property=ProtectSystem=strict \
		--property=ProtectHome=tmpfs \
		--property=BindPaths="$sbhome:$sbhome" \
		--property=ReadWritePaths="$sbhome" \
		--property=ProtectKernelTunables=yes \
		--property=ProtectKernelModules=yes \
		--property=ProtectControlGroups=yes \
		--property=UMask=0007 \
		--property=WorkingDirectory="$wd" \
			-- /usr/bin/env -i HOME="$sbhome" PATH="$fpath" USER="$SANDBOX_USER" LOGNAME="$SANDBOX_USER" \
				$env_proxy_vars \
				/bin/bash --login -c 'exec "$@"' -- "$@"
}

main() {
	require_root
	require_systemd_run

	PROXY_ADDR="$DEFAULT_PROXY_ADDR"
	PROXY_ADDR_WAS_SET=0
	CWD=""
	FULL_NETWORK=0
	while [ "$#" -gt 0 ]; do
		case "$1" in
			--proxy-addr)
				if [ "$FULL_NETWORK" -ne 0 ]; then
					log "--proxy-addr is mutually exclusive with --full-network"
					exit 2
				fi
				shift
				if [ "$#" -lt 1 ]; then
					log "--proxy-addr requires a value"
					exit 2
				fi
				validate_proxy_addr "$1"
				PROXY_ADDR="$1"
				PROXY_ADDR_WAS_SET=1
				shift
				;;
			--proxy-addr=*)
				if [ "$FULL_NETWORK" -ne 0 ]; then
					log "--proxy-addr is mutually exclusive with --full-network"
					exit 2
				fi
				p="${1#--proxy-addr=}"
				validate_proxy_addr "$p"
				PROXY_ADDR="$p"
				PROXY_ADDR_WAS_SET=1
				shift
				;;
			--full-network)
				if [ "$PROXY_ADDR_WAS_SET" -ne 0 ]; then
					log "--full-network is mutually exclusive with --proxy-addr"
					exit 2
				fi
				FULL_NETWORK=1
				shift
				;;
			--cwd)
				shift
				if [ "$#" -lt 1 ]; then
					log "--cwd requires a value"
					exit 2
				fi
				CWD="$1"
				shift
				;;
			--cwd=*)
				CWD="${1#--cwd=}"
				shift
				;;
			--)
				shift
				break
				;;
			-*)
				log "unknown flag: $1"
				exit 2
				;;
			*)
				break
				;;
		esac
	done

	require_args "$@"

	run_via_systemd "$@"
}

main "$@"
